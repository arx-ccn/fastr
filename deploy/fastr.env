# Environment for the fastr dinit service (loaded via env-file in fastr.dinit)

# Data directory
FASTR_DATA_DIR=/var/lib/fastr/data

# Bind on localhost only; TLS termination is handled by your reverse proxy
FASTR_ADDR=127.0.0.1
FASTR_PORT=8080

# Tune these to your workload
#FASTR_MAX_CONNECTIONS=1024
#FASTR_MAX_SUBSCRIPTIONS=20
#FASTR_MAX_FILTERS=10
#FASTR_MAX_LIMIT=500
#FASTR_MAX_MESSAGE_BYTES=131072
#FASTR_COMPACT_INTERVAL=21600
