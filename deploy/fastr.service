[Unit]
Description=fastr Nostr relay
Documentation=https://gitworkshop.dev/naddr1qqz5vctnw3eqz9rhwden5te0wfjkccte9ehxw6t59ejx2aszypnxw52cucecl6ylmfqcus4qhu4852cny5zd6drlq9dp39cmv3zrqqcyqqq80xgkgl8x7
After=network.target
Wants=network.target

[Service]
Type=simple
User=fastr
Group=fastr
ExecStart=/usr/local/bin/fastr
WorkingDirectory=/var/lib/fastr
Restart=on-failure
RestartSec=5

# Data directory
Environment=FASTR_DATA_DIR=/var/lib/fastr/data

# Bind on localhost only; TLS termination is handled by your reverse proxy
Environment=FASTR_ADDR=127.0.0.1
Environment=FASTR_PORT=8080

# Tune these to your workload
#Environment=FASTR_MAX_CONNECTIONS=1024
#Environment=FASTR_MAX_SUBSCRIPTIONS=20
#Environment=FASTR_MAX_FILTERS=32
#Environment=FASTR_MAX_FILTER_VALUES=4096
#Environment=FASTR_MAX_LIMIT=500
#Environment=FASTR_MAX_MESSAGE_BYTES=2097152
#Environment=FASTR_COMPACT_INTERVAL=21600

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/fastr

[Install]
WantedBy=multi-user.target
